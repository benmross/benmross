{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cv",
      "destination": "/cv.pdf",
      "permanent": true
    },
    {
      "source": "/cv/",
      "destination": "/cv.pdf",
      "permanent": true
    },
    {
      "source": "/documents/:path*",
      "destination": "/cv.pdf",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/cv.pdf",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/p/s.js",
      "destination": "https://benmross.com/_vercel/insights/script.js"
    },
    {
      "source": "/p/:path*",
      "destination": "https://benmross.com/_vercel/insights/:path*"
    }
  ]
}
